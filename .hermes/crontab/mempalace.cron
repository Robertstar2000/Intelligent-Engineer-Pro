# MemPalace Maintenance Cron Jobs
# Daily consolidation at 2 AM
0 2 * * * /usr/bin/python3 /home/bob/.hermes/mempalace/scripts/daily_consolidate.py >> /tmp/mempalace_consolidate.log 2>&1

# Weekly pruning at 3 AM every Sunday
0 3 * * 0 /usr/bin/python3 /home/bob/.hermes/mempalace/scripts/weekly_prune.py >> /tmp/mempalace_prune.log 2>&1
