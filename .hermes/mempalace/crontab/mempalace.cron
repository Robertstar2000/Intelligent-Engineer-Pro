# MemPalace daily consolidation - runs at 2 AM
0 2 * * * /usr/bin/python3 /home/bob/.hermes/mempalace/scripts/daily_consolidate.py >> /home/bob/.hermes/mempalace/logs/daily_consolidate.log 2>&1

# MemPalace weekly prune - runs at 3 AM every Sunday
0 3 * * 0 /usr/bin/python3 /home/bob/.hermes/mempalace/scripts/weekly_prune.py >> /home/bob/.hermes/mempalace/logs/weekly_prune.log 2>&1

# MemPalace embedding index maintenance - runs daily at 4 AM
0 4 * * * /usr/bin/python3 /home/bob/.hermes/mempalace/scripts/maintain_index.py >> /home/bob/.hermes/mempalace/logs/maintain_index.log 2>&1
