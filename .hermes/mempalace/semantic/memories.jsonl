{"id": "a5029832-054f-4aab-bbc3-a852d2dbf859", "original_id": "f57c924b-ae03-496b-9992-f4e58a141a94", "timestamp": "2026-06-22T14:20:55.318375+00:00", "consolidated_at": "2026-06-22T14:20:55.318388+00:00", "type": "technical_knowledge", "content": "DOX (Self-documenting AGENTS.md) is a framework by agent0ai that gives AI agents precise project context through a hierarchy of AGENTS.md files. The agent keeps a tree: root AGENTS.md has project-wide instructions and a top-level index; child AGENTS.md files contain local instructions for specific areas. Before any edit, the agent walks the docs tree from root to the target path. After meaningful changes, it updates the affected AGENTS.md files. No installation needed \u2014 just copy AGENTS.md into the project root. GitHub: https://github.com/agent0ai/dox", "context": "AI agent documentation framework", "summary": "[AI agent documentation framework] DOX by agent0ai \u2014 self-documenting AGENTS.md hierarchy for AI agent project context. Walk the tree before editing, update docs after changes. No install, just copy AGENTS.md.", "score_at_consolidation": 0.95, "score_components": {"recency": 1.0, "relevance": 1.0, "emotional": 0.5, "usage": 0.8, "novelty": 0.9, "clarity": 0.95, "social": 0.3}, "metadata": {"source": "github.com/agent0ai/dox", "tags": ["dox", "agents-md", "ai-agents", "documentation", "agent0ai"]}, "tags": {"projects": ["agent0ai/dox"], "technologies": ["markdown", "ai-agents"], "concepts": ["self-documenting", "hierarchy", "context-management"]}}
